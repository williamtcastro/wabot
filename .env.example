# Copy to .env and fill in. .env is git-ignored; it holds secrets.
# Docker Compose reads it on its own. For wame on your machine, load it into the shell first:
#   set -a; . ./.env; set +a

# Owner secret, 16+ characters: openssl rand -hex 24
# On a laptop running `wame admin`, this can instead be a named admin token (wame_…).
WAME_TOKEN=

# URL of the server that `wame admin` manages. https://, or http:// only for 127.0.0.1 / an SSH tunnel.
WAME_SERVER=http://127.0.0.1:8080

# Optional: deliver incoming messages to a webhook, signed with the secret (openssl rand -hex 24).
# WAME_WEBHOOK=https://example.com/hook
# WAME_WEBHOOK_SECRET=
# WAME_WEBHOOK_FILTER="type=text&from_me=false"

# Optional: sends per minute (0 = unlimited) and log format (text or json).
# WAME_RATE=20
# WAME_LOG_FORMAT=text
